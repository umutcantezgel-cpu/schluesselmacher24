# SCHLÜSSELMACHER24 — Umgebungsvariablen
#
# Diese Datei ist eine Vorlage. Kopieren nach .env.local und ausfüllen.
# Es sind bewusst KEINE Zugangsdaten hinterlegt.

# Öffentliche Adresse der Seite (für Metadaten, Sitemap und robots.txt)
NEXT_PUBLIC_SITE_URL=https://schluesselmacher24.de

# --- Online-Zahlung (offen) -------------------------------------------------
# Ohne diese Werte werden Vorgänge mit dem Zahlungsstatus "offen" angelegt
# und im Backend von Hand auf "bezahlt" gesetzt.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- E-Mail-Versand (offen) -------------------------------------------------
# Ohne diese Werte werden keine automatischen Bestätigungen versendet.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM_ADDRESS=

# --- Dateiablage für Uploads (offen) ----------------------------------------
# Ohne diese Werte wird am Vorgang nur vermerkt, welche Dateien der Kunde
# ausgewählt hat; die Dateien selbst werden nicht dauerhaft gespeichert.
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Datenhaltung -----------------------------------------------------------
# Auf Plattformen mit schreibgeschütztem Dateisystem auf 1 setzen. Das Backend
# zeigt dann beim Speichern einen klaren Hinweis, statt still zu scheitern.
SM24_READONLY_CONTENT=
