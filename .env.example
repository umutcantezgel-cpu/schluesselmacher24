# SCHLÜSSELMACHER24 — Umgebungsvariablen
#
# Vorlage: lokal nach .env.local kopieren, auf Vercel unter
# Project → Settings → Environment Variables eintragen (Scope „Production“).
# Es sind bewusst KEINE Zugangsdaten hinterlegt.
# Schritt-für-Schritt-Anleitung: docs/LIVEGANG.md
#
# NEXT_PUBLIC_* werden beim Build fest eingesetzt: nach jeder Änderung neu
# deployen. Das gilt auch für PAYMENT_* und MAIL_*, weil einige Seiten den
# Anbindungsstatus beim Build lesen.

# --- Adressen (Pflicht in Produktion) ---------------------------------------
# Öffentliche Adresse: Canonical, Sitemap, Rücksprünge von Stripe, Links in Mails
NEXT_PUBLIC_SITE_URL=https://schluesselmacher24.de
# Adresse des Backends (Payload): Reset-Links, Admin-Link in der Betriebsmail.
# In Produktion gleich der Site-Adresse. In Vorschauen leer lassen.
NEXT_PUBLIC_SERVER_URL=

# --- Suchmaschinen (optional) -------------------------------------------------
# Google Search Console: Wert des Meta-Tags „google-site-verification“ (nur der
# Inhalt, ohne HTML). Wird als <meta name="google-site-verification"> ausgegeben.
# Außerhalb der Produktion stehen alle Seiten ohnehin auf noindex.
GOOGLE_SITE_VERIFICATION=

# --- Datenbank: Supabase Postgres, Region Frankfurt (Pflicht in Produktion) --
# Rollen und Einrichtung: docs/SUPABASE.md. Nie die Rolle postgres eintragen.
# Laufzeit: „Transaction pooler“ (Port 6543), Benutzer sm24_app.<ref> (nur Datenrechte)
DATABASE_URL=
# Migrationen im Build: „Session pooler“ (Port 5432, Host *.pooler.supabase.com),
# Benutzer sm24_migration.<ref> (Eigentümer der Tabellen). Pflicht in Produktion.
# Nicht die direkte Adresse db.<ref>.supabase.co – die ist nur per IPv6 erreichbar.
DATABASE_URL_UNPOOLED=
# Supabase-SSL-Zertifikat (Database → Settings → SSL Configuration → Download).
# Inhalt der .crt-Datei einfügen (mehrzeilig oder mit \n). Ohne Zertifikat bricht
# der Produktions-Build ab (sonst liefe die Verbindung unverschlüsselt).
DATABASE_CA_CERT=
# Hinweis: Die Vercel-Supabase-Integration setzt POSTGRES_URL und
# POSTGRES_URL_NON_POOLING – die werden erkannt, sie nutzen aber die Rolle
# postgres und schreiben auch in Vorschauen. Deshalb nicht verwenden.
# Notausgänge (nur im Notfall): SM24_ROLLENTRENNUNG=aus (Build prüft die Rollen
# nicht), SM24_RECHTE_PRUEFUNG=warnung (Rechte-Prüfung nach den Migrationen
# meldet nur, statt abzubrechen).

# --- Backend (Pflicht in Produktion) -----------------------------------------
# Signiert Anmeldungen und Ratenzähler. Mindestens 32 Zeichen: openssl rand -hex 32
PAYLOAD_SECRET=
# Erster Inhaber-Zugang, legt der Produktions-Build einmalig an (Passwort ≥ 12 Zeichen).
# Nach der ersten Anmeldung Passwort im Backend ändern; die Werte können bleiben.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Zeitgesteuerte Läufe (Vercel Cron) -------------------------------------
# Schützt /api/cron/taeglich (Löschfristen) und /api/cron/zahlungen (Abgleich).
# Vercel sendet den Wert automatisch mit. openssl rand -hex 32
CRON_SECRET=

# --- Dateiablage: Supabase Storage über S3-Schnittstelle --------------------
# Den privaten Bucket sm24-dateien legt supabase/sql/0005_ablage.sql an.
# Zugangsschlüssel „vercel-laufzeit“: Storage → S3 → New access key.
# Ohne diese Werte sind Foto-Uploads und Medien auf Vercel nicht möglich.
STORAGE_ENDPOINT=https://<projekt-ref>.storage.supabase.co/storage/v1/s3
STORAGE_REGION=eu-central-1
STORAGE_BUCKET=sm24-dateien
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Betrieb: Uptime-Monitor und Überwachung (docs/SUPABASE.md) -------------
# Schlüssel für /api/gesundheit?schluessel=… (Uptime-Monitor alle 3–5 Minuten,
# hält das Free-Projekt wach). Mindestens 24 Zeichen: openssl rand -hex 24
# Leer oder kürzer: Die Route antwortet immer mit 404.
GESUNDHEIT_SCHLUESSEL=
# Schwellen der täglichen Betriebsprüfung (optional, Standard = Free-Plan).
# Nach einem Wechsel zu Pro anheben.
# SM24_GRENZE_DATENBANK_MB=500
# SM24_GRENZE_ABLAGE_MB=800
# SM24_GRENZE_WARNUNG_PROZENT=60
# SM24_GRENZE_KRITISCH_PROZENT=80
# SM24_GRENZE_SICHERUNG_STUNDEN=36
# SM24_GRENZE_EGRESS_MB=1536
# 0 = Lebenszeichen der Sicherung nicht prüfen (bis die Sicherung eingerichtet ist)
# SM24_SICHERUNG_PRUEFEN=0
# Nur für die Bürokopie (scripts/sicherung.mjs, Datei .env.sicherung), nicht in
# Vercel: Rolle sm24_sicherung (nur lesen) über den Session-Pooler, Port 5432.
# SICHERUNG_DATABASE_URL=postgresql://sm24_sicherung.<projekt-ref>:<passwort>@<pooler-host>:5432/postgres

# --- Online-Zahlung: Stripe Checkout -----------------------------------------
# Ohne diese Werte werden Vorgänge mit Zahlungsstatus „offen“ angelegt und im
# Backend von Hand auf „bezahlt“ gesetzt.
PAYMENT_PROVIDER=stripe
# Geheimer Schlüssel (sk_live_… / sk_test_…) oder eingeschränkter Schlüssel (rk_…)
PAYMENT_API_KEY=
# Signaturgeheimnis des Webhook-Endpunkts https://<domain>/api/zahlung/stripe (whsec_…)
PAYMENT_WEBHOOK_SECRET=
# Zahlarten, kommagetrennt, müssen im Stripe-Dashboard aktiv sein.
# card = Kredit-/Debitkarte inkl. Apple Pay und Google Pay. Weitere z. B. paypal, klarna.
PAYMENT_METHODS=card
# 1 = Stripe erzeugt zu jeder Zahlung eine Rechnung (kostenpflichtige Stripe-Funktion)
PAYMENT_INVOICES=

# --- E-Mail-Versand: Resend --------------------------------------------------
# Ohne diese Werte werden keine Mails versendet (Vorgänge werden trotzdem gespeichert).
MAIL_PROVIDER=resend
# API-Schlüssel (re_…) mit Sendeberechtigung für die verifizierte Domain
MAIL_API_KEY=
# Absender auf der verifizierten Domain
MAIL_FROM_ADDRESS=info@schluesselmacher24.de
MAIL_FROM_NAME=SCHLÜSSELMACHER24
# Antworten der Kunden landen hier (echtes Postfach). Leer = Firmen-E-Mail aus dem Backend.
MAIL_REPLY_TO=info@schluesselmacher24.de
# Empfänger der Betriebsmails (neuer Vorgang, Zahlung, Widerruf), kommagetrennt
MAIL_TEAM_ADDRESS=info@schluesselmacher24.de
# Nur Vorschau/lokal: alle Mails an diese Adresse umleiten (wirkt nie in Produktion)
MAIL_REDIRECT_TO=

# --- Statistik: Google Analytics 4 (nur nach Einwilligung) -------------------
# Mess-ID des GA4-Datenstroms (G-…). Leer = kein Analysedienst: nichts wird geladen,
# keine Einwilligungsfrage, kein Eintrag in Datenschutz und Cookie-Einstellungen.
# Gesetzt: Einwilligungsfrage beim ersten Besuch, Kategorie „Statistik“ in den
# Cookie-Einstellungen, GA4-Eintrag in der Datenschutzerklärung, CSP-Freigabe für
# Google. gtag.js lädt erst nach Zustimmung (Consent Mode v2, Standard „denied“).
# Wird beim Build fest eingesetzt: nach Änderung neu deployen.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Optional / Sonderfälle ---------------------------------------------------
# 1 = Vorschau-Deployments migrieren ihre (eigene!) Datenbank. Nie mit der Produktions-DB.
SM24_PREVIEW_MIGRATE=
# Nur lokal: json = ohne Datenbank aus content/*.json, lokal = Dateien auf der Festplatte
SM24_DATA=
SM24_STORAGE=
# Schreibschutz außerhalb von Vercel (z. B. eigener Server mit schreibgeschütztem Dateisystem)
SM24_READONLY_CONTENT=
