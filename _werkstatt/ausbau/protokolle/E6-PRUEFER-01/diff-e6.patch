+
+  it('nennt Postleitzahl und Ort zusammen und die Straße', () => {
+    const [anliegen] = einsatzZusammenfassung(daten({ strasse: 'Lahnstraße 1' }));
+    const zeile = (label: string) => anliegen.rows.find((r) => r.label === label)?.value;
