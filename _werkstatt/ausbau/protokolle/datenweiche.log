import { baueKatalog, abdeckung, GESAMTBESTAND, STANDARD_CSV } from '/home/user/schluesselmacher24/scripts/fahrzeuge-import.mjs';
const csv = readFileSync(STANDARD_CSV, 'utf8');
const bestand = JSON.parse(readFileSync('/home/user/schluesselmacher24/content/vehicles.json', 'utf8'));
const { reihen, kennzahlen } = baueKatalog({ csv, bestand });
console.log(JSON.stringify(kennzahlen));
const ab = abdeckung(reihen);
console.log('abdeckung', ab.summe, (ab.anteil * 100).toFixed(4));
console.log('--- bestand links');
for (const r of reihen.filter(r => r.bestandsModell)) console.log(`${r.bestandsModell} -> id=${r.id} reihe=${r.reihe} kba=${r.kbaName} alias=${JSON.stringify(r.alias ?? [])} bestand=${r.bestand} rang=${r.rang}`);
