# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Vorgangsdaten enthalten Kundendaten und gehören nicht in die Versionsverwaltung
/content/records.json
tsbuildinfo
dev_server.log

# Lokale Datenbank (embedded-postgres) und hochgeladene Dateien — nie ins Repo
/.data/
/media/
/private-uploads/

# Test- und Prüfausgaben
/test-results/
/playwright-report/

# Worktrees der Hilfsagenten
/.claude/worktrees/
